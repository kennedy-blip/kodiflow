{
  "name": "kodiflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "KodiFlow — Smart Rental Property, Water Billing & Caretaker OS",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && node scripts/prepare-native.mjs && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "framer-motion": "^11.11.9",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.7.0",
    "fake-indexeddb": "^6.2.8",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "vite": "^6.4.6"
  }
}
